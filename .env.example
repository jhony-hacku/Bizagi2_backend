# Genera JWT_SECRET: openssl rand -base64 48 (no uses una frase ni una clave de ejemplo).
# Copia este archivo como .env y ajusta los valores a tu maquina
DB_USERNAME=postgres
DB_PASSWORD=tu_password_de_postgres
JWT_SECRET=

# Opcionales (valores por defecto: access 15 min, refresh 7 dias, cookie Secure)
# JWT_ACCESS_EXPIRATION_MS=900000
# JWT_REFRESH_EXPIRATION_MS=604800000
# JWT_REFRESH_COOKIE_SECURE=true
