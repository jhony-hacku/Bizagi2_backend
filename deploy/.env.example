# Copia este archivo como .env (en esta misma carpeta) y cambia los valores.
# El .env real nunca se sube al repositorio.

# --- Base de datos ---
POSTGRES_DB=bizagi2
POSTGRES_USER=bizagi
# Genera una con: openssl rand -hex 24
POSTGRES_PASSWORD=cambia-esta-clave

# --- Backend ---
# Minimo 32 caracteres. Genera una con: openssl rand -hex 32
JWT_SECRET=cambia-este-secreto-de-al-menos-32-caracteres
JWT_EXPIRATION_MS=86400000
# update: Hibernate crea y ajusta las tablas solo.
# Cuando se agreguen migraciones (Flyway), cambiar a validate.
DDL_AUTO=update
SWAGGER_ENABLED=false

# --- Version de las imagenes a desplegar ---
BACKEND_TAG=latest
FRONT_TAG=latest

# --- Donde escucha el front en la maquina ---
# 127.0.0.1 = solo local (lo normal detras de un tunel). 0.0.0.0 = toda la red.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
