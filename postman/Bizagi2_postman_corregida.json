   "name": "HU-01 Registro de Empresa",
   "item": [
    {
     "name": "01.1 Registrar empresa y admin",
     "event": [
      {
       "listen": "test",
       "script": {
        "exec": [
         "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
         "const body = pm.response.json();",
         "pm.test('Respuesta contiene token', () => pm.expect(body.token).to.be.a('string'));",
         "pm.test('Respuesta contiene usuarioId', () => pm.expect(body.usuarioId).to.be.a('number'));",
         "pm.test('Respuesta contiene empresaId', () => pm.expect(body.empresaId).to.be.a('number'));",
         "pm.test('Rol es ADMINISTRADOR', () => pm.expect(body.rolAcceso).to.eql('ADMINISTRADOR'));",
         "pm.collectionVariables.set('token', body.token);",
         "pm.collectionVariables.set('usuarioId', body.usuarioId);",
         "pm.collectionVariables.set('empresaId', body.empresaId);"
        ]
       }
      }
     ],
     "request": {
      "auth": {
       "type": "noauth"
      },
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "body": {
       "mode": "raw",
       "raw": "{\n  \"nombreEmpresa\": \"Acme SAS\",\n  \"nit\": \"900123456\",\n  \"emailContacto\": \"contacto@acme.com\",\n  \"nombre\": \"Ana Perez\",\n  \"email\": \"ana@acme.com\",\n  \"password\": \"Clave12345\"\n}"
      },
